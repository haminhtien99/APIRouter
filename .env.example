# APIRouter environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/apirouter

# Recommended runtime variables
PORT=20228
HOSTNAME=127.0.0.1
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20228
# CLOUD_URL=
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20228
# NEXT_PUBLIC_CLOUD_URL=

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Optional local Telegram dashboard bot
# TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token
# Optional admission allowlist. Authentication still requires the Web UI password.
# TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
# APIRouter_BASE_URL=http://127.0.0.1:20228
# TELEGRAM_SESSION_FILE=/var/lib/apirouter/telegram-bot/sessions.json
# Session expires after this many inactive days. Password/auth-mode changes revoke it immediately.
# TELEGRAM_SESSION_TTL_DAYS=30

# Optional Google OAuth clients for Antigravity and Gemini login flows
# ANTIGRAVITY_OAUTH_CLIENT_ID=
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=apirouter
